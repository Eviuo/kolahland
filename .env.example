# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/kolahland?schema=public"

# --- Auth.js v5 ---
AUTH_SECRET="generate-with-npx-auth-secret"

# --- Admin account (used only by prisma/seed.ts — set your real email/password here,
# never in code or chat, then run: npm run db:seed) ---
SEED_ADMIN_EMAIL="you@your-real-email.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# --- Payments (modular — see src/lib/payments) ---
PAYMENT_PROVIDER="zarinpal" # "zarinpal" | "stripe"

ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://kolahland.ir"

# --- Email (order confirmations, password reset) ---
EMAIL_SERVER=""
EMAIL_FROM="no-reply@kolahland.ir"
